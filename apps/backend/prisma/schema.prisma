generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id             String         @id @default(uuid())
  email          String         @unique
  hashedPassword String
  phone          String
  fullName       String         @default("Update_Later")
  identityCard   String?        @default("Unknown")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt()
  tenantProfile  TenantProfile?
  ownerProfile   OwnerProfile?
  rentalRequests RentalRequest[]
}

model TenantProfile {
  id        String @id @default(uuid())
  accountId String @unique
  fullName  String
  job       String?
  isActive  Boolean  @default(false)

  account               Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contracts            Contract[]        @relation("TenantContracts")
  reviewGivenApartment ReviewApartment[] @relation("TenantApartmentReviewer")
  tenantReviewReceived  ReviewTenant[]    @relation("TenantReviewed")
}

model OwnerProfile {
  id        String @id @default(uuid())
  accountId String @unique
  fullName  String

  taxCode     String? // Mã số thuế
  bankAccount String? // STK nhận tiền VietQR

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Quan hệ nghiệp vụ dời từ User sang đây
  ownedApartments   Apartment[]    @relation("OwnerApartments")
  contracts         Contract[]     @relation("OwnerContracts")
  tenantReviewGiven ReviewTenant[] @relation("OwnerReviewer")
}

model Apartment {
  id          String         @id @default(uuid())
  floor       Int
  area        Decimal        @db.Decimal(6, 2)
  type        ApartmentTypes @default(Normal)
  district    String         @default("Update_Later")
  fullAddress String         @default("Update_Later")
  room_number Int            @default(1)
  note        String         @default("Unknown")
  bedroom     Int            @default(1) @db.Integer
  livingroom  Int            @default(1) @db.Integer
  bathroom    Int            @default(1) @db.Integer
  kitchen     Int            @default(1) @db.Integer
  rentalRequests RentalRequest[]

  apartmentStatus ApartmentStatus @default(Available)

  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner              OwnerProfile               @relation("OwnerApartments", fields: [ownerId], references: [id])
  apartmentAmenities ApartmentAmenity[]
  contracts          Contract[]
  apartmentListing   Listing?
  reviews            ReviewApartment[]
}

model ApartmentAmenity {
  apartmentAmenityStatus ApartmentAmenityStatus @default(Unavailable)
  apartmentId            String
  amenityId              String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  amenity                Amenity                @relation(fields: [amenityId], references: [id])
  apartment              Apartment              @relation(fields: [apartmentId], references: [id])

  @@id([amenityId, apartmentId])
}

model Amenity {
  id         String             @id @default(uuid())
  name       String
  category   AmenityCategory
  value      AmenityValue
  icon       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  apartments ApartmentAmenity[]
}

model Contract {
  id              String           @id @default(uuid())
  rentPrice       Decimal          @db.Decimal(12, 2)
  deposit         Decimal          @db.Decimal(12, 2)
  terms           String?          // Các điều khoản cho hợp đồng
  terminationReason String?
  startDate       DateTime
  endDate         DateTime

  apartmentId     String
  tenantId        String
  ownerId         String

  contractStatus  ContractStatus   @default(Draft)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  signAt          DateTime?
  terminateAt     DateTime?

  apartment       Apartment        @relation(fields: [apartmentId], references: [id])
  owner           OwnerProfile             @relation("OwnerContracts", fields: [ownerId], references: [id])
  tenant          TenantProfile             @relation("TenantContracts", fields: [tenantId], references: [id])
  payments        Payment[]
  reviewApartment ReviewApartment?
  reviewTenant    ReviewTenant?

  @@index([tenantId])
  @@index([ownerId])
}

model RentalRequest{
  id          String    @id @default(uuid())
  accountId   String
  apartmentId String
  message     String?

  status      RentalRequestStatus @default(Pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  apartment   Apartment        @relation(fields: [apartmentId], references: [id])
  account     Account          @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([apartmentId])
}

model Payment {
  id          String        @id @default(uuid())
  paymentDate DateTime      @default(now())
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(Pending)
  contractId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contract    Contract      @relation(fields: [contractId], references: [id])
}

model Listing {
  id            String          @id @default(uuid())
  listingStatus ListingStatus   @default(Draft)
  title         String
  description   String
  pricePerMonth Decimal         @db.Decimal(12, 2)
  apartmentId   String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  apartment     Apartment       @relation(fields: [apartmentId], references: [id])
  images        ListingImages[]
}

model ListingImages {
  id        String   @id @default(uuid())
  imageUrl  String
  isPrimary Boolean
  listingId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id])
}

model ReviewApartment {
  id          String    @id @default(uuid())
  contractId  String    @unique
  apartmentId String
  reviewerId  String
  review      Json
  comment     String?
  createdAt   DateTime  @default(now())
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  contract    Contract  @relation(fields: [contractId], references: [id])
  reviewer    TenantProfile      @relation("TenantApartmentReviewer", fields: [reviewerId], references: [id])
}

model ReviewTenant {
  id         String   @id @default(uuid())
  contractId String   @unique
  tenantId   String
  reviewerId String
  review     Json
  comment    String?
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id])
  reviewer   OwnerProfile     @relation("OwnerReviewer", fields: [reviewerId], references: [id])
  tenant     TenantProfile     @relation("TenantReviewed", fields: [tenantId], references: [id])
}

enum ApartmentStatus {
  Rented
  Available
}

enum ApartmentTypes {
  Normal
  Studio
  Officetel
  Shophouse
  Penthouse
  Duplex
  SkyVilla
}

enum RentalRequestStatus {
  Pending
  Accepted
  Rejected
  Cancelled
}

enum ContractStatus {
  Draft
  PendingTenantSignature
  Active
  Expired
  TerminationRequested
  Terminated
  RejectedByTenant
}

enum PaymentStatus {
  Pending
  Paid
  Failed
}

enum ApartmentAmenityStatus {
  Working
  Broken
  Unavailable
}

enum AmenityCategory {
  Furniture
  Building
  Policy
}

enum AmenityValue {
  Boolean
  Text
}

enum ListingStatus {
  Draft
  Published
  Rented
  HIDDEN
}
