+                    c.contractStatus === 'Draft' || c.status === 'pending' ? 'bg-amber-500/20 text-amber-400' :
+                    c.contractStatus === 'Expired' || c.status === 'expired' ? 'bg-red-500/20 text-red-400' :
+                    'bg-gray-500/20 text-gray-400'
